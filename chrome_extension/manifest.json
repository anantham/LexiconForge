{
  "manifest_version": 3,
  "name": "LexiconForge Scraper",
  "version": "2.1",
  "description": "Polyglotta scraper for LexiconForge: multilingual aligned Buddhist texts. BookToki removed 2026-08-23.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.hf.uio.no/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LexiconForge Scraper"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hf.uio.no/polyglotta/*"
      ],
      "js": [
        "content-polyglotta.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
