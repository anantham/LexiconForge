# The browser app is BYOK-only. Add Gemini, OpenAI, DeepSeek, Claude,
# OpenRouter, and PiAPI credentials through Settings, never through VITE_ vars.

# Optional public browser configuration. The default is modern IndexedDB storage.
# VITE_DB_BACKEND=modern

# Node-only benchmark and curation scripts may read this when launched with
# `npx tsx --env-file=.env.local ...`. It is never a browser fallback.
OPENROUTER_API_KEY=your_openrouter_api_key_here
