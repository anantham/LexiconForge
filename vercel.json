{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/comics/the-occasion/editorial",
      "destination": "/comics/the-occasion/editorial/index.html"
    },
    {
      "source": "/comics/the-occasion/editorial/",
      "destination": "/comics/the-occasion/editorial/index.html"
    },
    {
      "source": "/comics/the-occasion",
      "destination": "/comics/the-occasion/index.html"
    },
    {
      "source": "/comics/the-occasion/",
      "destination": "/comics/the-occasion/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
